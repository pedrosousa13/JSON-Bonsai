{
  "name": "json-bonsai",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ./scripts/build.mjs --watch",
    "build": "node ./scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "zip": "npm run build && node ./scripts/zip-dist.mjs",
    "package": "npm run build && node ./scripts/zip-dist.mjs json-bonsai-chrome.zip && node ./scripts/zip-dist.mjs json-bonsai-firefox.zip",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/chrome": "^0.1.39",
    "@types/jmespath": "^0.15.2",
    "@types/node": "^25.5.2",
    "esbuild": "^0.28.1",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.0",
    "vitest": "^4.0.0",
    "yazl": "^3.3.1"
  },
  "dependencies": {
    "jmespath": "^0.16.0"
  },
  "overrides": {
    "vite": "^8.0.0"
  }
}
